# Copy this to .env and fill in your values

# REQUIRED: Secret key used to sign ticket tokens (generate with: python -c "import secrets; print(secrets.token_hex(32))")
TICKET_SECRET=your-secret-key-here

# Neon PostgreSQL connection string (leave blank to use local SQLite)
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Resend Email API settings (https://resend.com)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Brevo (Sendinblue) API key — alternative to Resend
BREVO_API_KEY=

# Default sender email. After domain verification use tickets@yourdomain.com
FROM_EMAIL=tickets@yourdomain.com

# The public base URL of your deployed app (used for QR code and ticket links)
# APP_BASE_URL=https://your-app.onrender.com
